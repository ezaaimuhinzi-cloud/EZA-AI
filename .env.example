# PostgreSQL (Supabase connection string)
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# JWT — generate a strong random secret
JWT_SECRET=change-me-to-a-long-random-string

# Africa's Talking SMS (for OTP)
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key

# HuggingFace Space URL (AI inference)
AI_SERVICE_URL=https://ezaaimuhinzi-ezaai.hf.space

# Admin panel key (protect /admin/* endpoints)
ADMIN_KEY=change-me-admin-secret

# Set to "true" during development — OTP returned in API response instead of SMS
DEV_MODE=true

# Flutterwave webhook secret (for payment verification)
FLW_SECRET_KEY=your-flutterwave-secret-key
